<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Test Blog</title>
    <link rel="stylesheet" href="/theme/style.css"/>
    
    <script type="module">import "htmx.org"</script>
</head>
<body>
<div id="wrapper">

<div id="header">
    <h1><a href="/">Test Blog</a></h1>
    <p class="description">Just another Press blog</p>
</div>

<div id="content">
    <article class="post" id="post-2">
    <h2><a href="/2004/01/second-post">Second Post</a></h2>
    <p class="post-meta">
        January 2, 2004 by admin
        
    </p>
    <div class="entry"><p>Another post.</p></div>
</article>

    <div class="comments" id="post-2-comments">
    <h2>Comments</h2>
    <div class="comment-list">
        
        <p data-empty="">No comments yet.</p>

        
    </div>
</div>

    
    <p class="comments-closed">Comments are closed.</p>
    
    <nav class="post-navigation">
    
    
</nav>

</div>

<div id="sidebar" role="complementary">
    <form class="search-form" method="get" action="/">
    <label for="s">Search</label>
    <input type="text" name="s" id="s" value=""/>
    <button type="submit">Search</button>
</form>

    
    <div class="widget widget-categories">
    <h2>Categories</h2>
    <ul>
        
        <li><a href="/category/uncategorized">Uncategorized</a></li>
        
        <li><a href="/category/news">News</a></li>
        
    </ul>
</div>

    
    
    <div class="widget widget-archives">
    <h2>Archives</h2>
    <ul>
        
        <li><a href="/2004/01">January 2004</a></li>
        
        <li><a href="/2004/02">February 2004</a></li>
        
    </ul>
</div>

    
    
    <div class="widget widget-pages">
    <h2>Pages</h2>
    <ul>
        
        <li><a href="/about">About</a></li>
        
        <li><a href="/contact">Contact</a></li>
        
    </ul>
</div>

    
    <div class="widget widget-meta">
    <h2>Meta</h2>
    <ul>
        
        <li><a href="/wp-admin/">Dashboard</a></li>
        <li><a href="/wp-login.php?action=logout">Log out</a></li>
        
    </ul>
</div>

</div>


</div>

</body>
</html>
