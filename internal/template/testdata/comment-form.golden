(document
  (element "form" (method "post") (action "/comments") (hx-post "/comments") (hx-target "this") (hx-swap "outerHTML") (hx-disabled-elt "this, find [type='submit']")
    (element "input" (type "hidden") (name "comment_post_id") (value "1"))
    (element "input" (type "hidden") (name "_csrf") (value "test-csrf-token"))
    (element "p"
      (element "label" (for "author")
        (text "Name")
      )
      (element "br")
      (element "input" (type "text") (name "author") (id "author") (value ""))
    )
    (element "p"
      (element "label" (for "email")
        (text "Email")
      )
      (element "br")
      (element "input" (type "email") (name "email") (id "email") (value ""))
    )
    (element "p"
      (element "label" (for "url")
        (text "Website")
      )
      (element "br")
      (element "input" (type "url") (name "url") (id "url") (value ""))
    )
    (element "p"
      (element "label" (for "comment")
        (text "Comment")
      )
      (element "br")
      (element "textarea" (name "comment") (id "comment") (rows "8") (cols "50"))
    )
    (element "p"
      (element "button" (type "submit")
        (text "Submit Comment")
      )
    )
  )
)
