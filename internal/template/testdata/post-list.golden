(document
  (element "div" (class "post-list")
    (element "article" (class "post")
      (element "h2"
        (element "a" (href "/2004/01/hello-world")
          (text "Hello World")
        )
      )
      (element "p" (class "post-meta")
        (text "January 1, 2004")
        (text " by ")
        (text "admin")
        (text "\n            in ")
        (element "a" (href "/category/uncategorized")
          (text "Uncategorized")
        )
        (text ", ")
        (element "a" (href "/category/news")
          (text "News")
        )
      )
      (element "div" (class "entry")
        (raw "<p>Welcome to Press.</p>")
      )
    )
    (element "article" (class "post")
      (element "h2"
        (element "a" (href "/2004/01/second-post")
          (text "Second Post")
        )
      )
      (element "p" (class "post-meta")
        (text "January 2, 2004")
        (text " by ")
        (text "admin")
      )
      (element "div" (class "entry")
        (raw "<p>Another post.</p>")
      )
    )
  )
)
