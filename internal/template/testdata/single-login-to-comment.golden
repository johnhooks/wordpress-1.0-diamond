(document
  (element "div" (id "wrapper")
    (element "div" (id "header")
      (element "h1"
        (element "a" (href "/")
          (text "Test Blog")
        )
      )
      (element "p" (class "description")
        (text "Just another Press blog")
      )
    )
    (element "div" (id "content")
      (element "article" (class "post")
        (element "h2"
          (element "a" (href "/2004/01/hello-world")
            (text "Hello World")
          )
        )
        (element "p" (class "post-meta")
          (text "January 1, 2004")
          (text " by ")
          (text "admin")
          (text "\n            in ")
          (element "a" (href "/category/uncategorized")
            (text "Uncategorized")
          )
          (text ", ")
          (element "a" (href "/category/news")
            (text "News")
          )
        )
        (element "div" (class "entry")
          (raw "<p>Welcome to Press.</p>")
        )
      )
      (element "div" (class "comments")
        (element "h2"
          (text "Comments")
        )
        (element "div" (class "comment-list")
          (element "div" (class "comment")
            (element "p" (class "comment-meta")
              (element "strong"
                (element "a" (href "https://alice.example.com")
                  (text "Alice")
                )
              )
              (text "\n        | ")
              (text "January 2, 2004")
            )
            (element "div" (class "comment-content")
              (raw "<p>Great post!</p>")
            )
          )
        )
      )
      (element "p" (class "comments-login")
        (text "You must be ")
        (element "a" (href "/wp-login.php")
          (text "logged in")
        )
        (text " to comment.")
      )
      (element "nav" (class "post-navigation")
      )
    )
    (element "div"
      (element "form" (class "search-form") (method "get") (action "/")
        (element "label" (for "s")
          (text "Search")
        )
        (element "input" (type "text") (name "s") (id "s") (value ""))
        (element "button" (type "submit")
          (text "Search")
        )
      )
      (element "div" (class "widget widget-categories")
        (element "h2"
          (text "Categories")
        )
        (element "ul"
          (element "li"
            (element "a" (href "/category/uncategorized")
              (text "Uncategorized")
            )
          )
          (element "li"
            (element "a" (href "/category/news")
              (text "News")
            )
          )
        )
      )
      (element "div" (class "widget widget-archives")
        (element "h2"
          (text "Archives")
        )
        (element "ul"
          (element "li"
            (element "a" (href "/2004/01")
              (text "January 2004")
            )
          )
          (element "li"
            (element "a" (href "/2004/02")
              (text "February 2004")
            )
          )
        )
      )
      (element "div" (class "widget widget-pages")
        (element "h2"
          (text "Pages")
        )
        (element "ul"
          (element "li"
            (element "a" (href "/about")
              (text "About")
            )
          )
          (element "li"
            (element "a" (href "/contact")
              (text "Contact")
            )
          )
        )
      )
      (element "div" (class "widget widget-meta")
        (element "h2"
          (text "Meta")
        )
        (element "ul"
          (element "li"
            (element "a" (href "/wp-login.php")
              (text "Log in")
            )
          )
        )
      )
    )
  )
)
