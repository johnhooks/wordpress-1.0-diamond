(document
  (element "nav" (class "post-navigation")
    (element "span" (class "prev")
      (text "« ")
      (element "a" (href "/earlier")
        (text "Earlier Post")
      )
    )
    (element "span" (class "next")
      (element "a" (href "/later")
        (text "Later Post")
      )
      (text " »")
    )
  )
)
