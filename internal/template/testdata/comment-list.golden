(document
  (element "div" (class "comments")
    (element "h2"
      (text "Comments")
    )
    (element "div" (class "comment-list")
      (element "div" (class "comment")
        (element "p" (class "comment-meta")
          (element "strong"
            (element "a" (href "https://alice.example.com")
              (text "Alice")
            )
          )
          (text "\n        | ")
          (text "January 2, 2004")
        )
        (element "div" (class "comment-content")
          (raw "<p>Great post!</p>")
        )
      )
      (element "div" (class "comment")
        (element "p" (class "comment-meta")
          (element "strong"
            (text "Bob")
          )
          (text "\n        | ")
          (text "January 3, 2004")
        )
        (element "div" (class "comment-content")
          (raw "<p>Thanks for sharing.</p>")
        )
      )
    )
  )
)
