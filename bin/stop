#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "$0")/env"

SITE="${1:-local}"
PID_FILE="$PID_DIR/${SITE//\//_}.pid"

if [ ! -f "$PID_FILE" ]; then
    exit 0
fi

entry=$(cat "$PID_FILE")
pid="${entry%%:*}"
port="${entry##*:}"

if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    echo "Stopped PID $pid ($SITE)"
elif [ -n "$port" ]; then
    fuser -k "$port/tcp" 2>/dev/null && echo "Killed stale process on port $port ($SITE)" || true
fi

rm -f "$PID_FILE"
